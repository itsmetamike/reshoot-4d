+def _keep_subject(masks: np.ndarray, kp2d: np.ndarray, pad: float = 0.25) -> np.ndarray:
+    """Zero the foreground outside the tracked person's keypoint box (padded for hair, hands and shoes)."""
+    out = masks.copy()
+    height, width = masks.shape[1:]
+    for f in range(len(masks)):
+        k = kp2d[f]
+        k = k[k[:, 2] > 0.3] if k.shape[-1] > 2 and (k[:, 2] > 0.3).sum() >= 4 else k
+        x0, y0, x1, y1 = k[:, 0].min(), k[:, 1].min(), k[:, 0].max(), k[:, 1].max()
+        px, py = (x1 - x0) * pad + 8, (y1 - y0) * pad + 8
+        keep = np.zeros((height, width), bool)
+        keep[max(0, int(y0 - py)):int(y1 + py) + 1, max(0, int(x0 - px)):int(x1 + px) + 1] = True
+        out[f][~keep] = 0
+    return out
+
+
